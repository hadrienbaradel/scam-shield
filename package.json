{
  "name": "scam-shield",
  "version": "0.3.0",
  "description": "Scam Shield: senior-first Gmail + SMS scam protection judging messages against the user's own life. Meta Global AI Developer Hackathon, Indie track.",
  "type": "module",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node --env-file-if-exists=.env --import ./lib/credentials.js src/server.js",
    "dev": "node --env-file-if-exists=.env --import ./lib/credentials.js --watch-path=src --watch-path=lib --watch-path=public src/server.js",
    "migrate": "node --env-file-if-exists=.env --import ./lib/credentials.js src/db/migrate.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:db-clean": "node --env-file-if-exists=.env --import ./lib/credentials.js src/db/testDatabase.js clean",
    "coverage": "mkdir -p coverage && node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=\"lib/**\" --test-coverage-include=\"src/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"tests/**/*.test.js\"",
    "check": "node scripts/doctor.mjs testdb --quiet --strict && mkdir -p coverage && node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=\"lib/**\" --test-coverage-include=\"src/**\" --test-coverage-lines=84 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"tests/**/*.test.js\"",
    "doctor": "node scripts/doctor.mjs",
    "credentials": "node scripts/credentials.mjs",
    "score": "node --import ./lib/credentials.js scripts/score.mjs",
    "gate": "node --env-file-if-exists=.env --import ./lib/credentials.js scripts/inbox-gate.mjs"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "fastify": "^5.12.7",
    "google-auth-library": "^11.3.1",
    "mailparser": "^3.12.4",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "undici": "^7.30.1"
  }
}
