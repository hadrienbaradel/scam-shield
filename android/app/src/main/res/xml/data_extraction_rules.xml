<?xml version="1.0" encoding="utf-8"?>
<!-- Never back up or transfer the device token, stored verdicts or queued texts. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="session.xml" />
        <exclude domain="sharedpref" path="checks.xml" />
        <exclude domain="database" path="androidx.work.workdb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="session.xml" />
        <exclude domain="sharedpref" path="checks.xml" />
        <exclude domain="database" path="androidx.work.workdb" />
    </device-transfer>
</data-extraction-rules>
