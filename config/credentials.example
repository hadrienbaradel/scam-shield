# Scam Shield keys, by name. The real values live encrypted in config/credentials.enc
# (set them with `make secrets-set KEY=value`; `make secrets-keys` lists what is set);
# the shell and a .env file (transition only) win over the credentials. Never commit
# config/master.key or a value. Rules: _product/docs/secrets.md

# --- Server (defaults in src/config.js; set only to change them) ---
# PORT=3000
# Loopback only by default. Set HOST=0.0.0.0 only while pairing a real phone on your LAN.
# HOST=127.0.0.1
# Open the app at exactly this address (Google sign-in and cookies depend on it).
# BASE_URL=http://localhost:3000
# The team's shared production database over Tailscale (make server, make db-prod-shell; _product/docs/ops.md):
# postgres://scam_shield:<password>@100.127.78.127:5432/scam_shield, stored by make deploy or make db-prod-url, never
# typed. The environment wins over it (the host's container, make server DB=dev). Without it (a clone of your own)
# the app uses postgres://localhost/scam_shield. Never as TEST_DATABASE_URL: the tests empty their database.
# DATABASE_URL=
# TEST_DATABASE_URL=postgres://localhost/scam_shield_test
# 32 random bytes, base64. Encrypts Google tokens at rest; `make setup` generates it.
# Losing it means users reconnect Gmail. REQUIRED.
TOKEN_ENC_KEY=
# Comma-separated Google emails allowed on the threat-feed review page.
ADMIN_EMAILS=

# --- Google (docs/GOOGLE_SETUP.md; node scripts/import-google-client.mjs <downloaded json>) REQUIRED ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: instant checks via Gmail push. Full resource names.
# GMAIL_PUBSUB_TOPIC=projects/<project-id>/topics/gmail-push
# GMAIL_PUBSUB_SUBSCRIPTION=projects/<project-id>/subscriptions/gmail-push-local
# SYNC_POLL_SECONDS=120

# --- Meta Model API (Muse Spark), Standard mode only. REQUIRED ---
META_MODEL_API_KEY=
# META_MODEL_BASE_URL=https://api.meta.ai/v1
# Never a "-contributor" model: the app refuses them.
# META_MODEL_NAME=muse-spark-1.3
# META_MODEL_REASONING_EFFORT=low

# --- Other model providers (_product/docs/llm.md); Meta is the default ---
# LLM_PROVIDER=meta            meta | openai | anthropic | mock
# LLM_MODEL=                   overrides the provider's default model
# LLM_BASE_URL=                an OpenAI-style endpoint (local models, gateways)
# LLM_THINKING=                reasoning effort for providers that take one
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# Muse Spark Open, Meta's open weights, served by Baseten: LLM_PROVIDER=baseten, or make score-open for the
# seed cases (_product/research/open-weights.md). Baseten's own key (app.baseten.co, API keys); no other provider reads it.
# BASETEN_API_KEY=
# Photos (the ad studio, _product/specs/ad-studio.md): Muse Image on META_MODEL_API_KEY by default.
# IMAGE_PROVIDER=meta          meta (Muse Image) | openai (any OpenAI-style images endpoint, OPENAI_API_KEY) | mock
# IMAGE_MODEL=                 default muse-image-1.0 (meta), gpt-image-1 (openai)
# IMAGE_BASE_URL=              an OpenAI-style images endpoint's /v1 address (openai: a self-hosted server needs no key)

# --- WhatsApp Cloud API ("forward it to Prudence", _product/specs/whatsapp-channel.md). Optional: without
# the first two the webhook answers 501 and the app runs as before; without the App Secret every delivery
# is refused (403). Meta app → WhatsApp → API Setup.
# A system-user token (the temporary one expires in 24 h) with whatsapp_business_messaging and
# whatsapp_business_management.
# WHATSAPP_ACCESS_TOKEN=
# The test number's "Phone number ID" (not the number itself).
# WHATSAPP_PHONE_NUMBER_ID=
# The number itself, digits only with the country code (e.g. 15551234567), not secret: Settings shows it as a wa.me link.
# WHATSAPP_PHONE_NUMBER=
# The "WhatsApp Business Account ID"; kept for QR deep links and templates, unused by the webhook.
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# Any string you choose; paste the same one in the webhook configuration (Verify token).
# WHATSAPP_VERIFY_TOKEN=
# The app's App Secret (App settings → Basic): signs every delivery, always checked, never skipped.
# WHATSAPP_APP_SECRET=
# Graph API version for the media and reply calls.
# WHATSAPP_GRAPH_VERSION=v22.0
# The Meta app's id (App settings → Basic), shared by the Messenger and WhatsApp channels; not secret. Read by
# scripts/whatsapp-check.mjs for the app's webhook subscription (with the App Secret, as the app token).
# META_APP_ID=
# ffmpeg converts voice notes (Ogg/Opus) to WAV for Muse Voice Transcribe; the one on PATH by default.
# FFMPEG_PATH=ffmpeg

# --- Facebook and Messenger ("send it to Prudence", _product/specs/messenger-channel.md). Optional: without
# the first two the webhook answers 501 and the app runs as before; without the App Secret every delivery
# is refused (403). Meta app → Messenger → Messenger API Settings; the Page must be linked to the app.
# The Page access token ("Generate token" next to the Page), with pages_messaging. Sent only to the Graph API.
# MESSENGER_PAGE_ACCESS_TOKEN=
# The Page's id (Page → About → Page transparency, or the Messenger API Settings list); replies go to /<id>/messages.
# MESSENGER_PAGE_ID=
# Any string you choose; paste the same one in the webhook configuration (Verify token).
# MESSENGER_VERIFY_TOKEN=
# The app's App Secret (App settings → Basic): signs every delivery, always checked, never skipped.
# MESSENGER_APP_SECRET=
# The Page's m.me address (https://m.me/<page id>; a fresh Page gets no username), not secret: Settings shows it as "Open Messenger".
# MESSENGER_PAGE_LINK=
# Graph API version for the reply calls.
# MESSENGER_GRAPH_VERSION=v26.0
# How long Prudence waits after the last message before judging them together, in milliseconds.
# MESSENGER_GROUP_MS=3000
# FFMPEG_PATH (above) also converts Messenger voice messages.

# --- Ad studio, Facebook ads (_product/specs/ad-studio.md). Optional: without the first two, Publish names the
# missing key and nothing leaves. Check: node --import ./lib/credentials.js scripts/ads-check.mjs status
# A system-user token of the Hey Prudence business portfolio with ads_management, pages_manage_ads,
# pages_read_engagement and pages_show_list (Business settings → System users → Generate new token). Sent only to the Graph API.
# META_ADS_TOKEN=
# The ad account, act_<digits> (the digits alone work too): Business settings → Accounts → Ad accounts.
# META_AD_ACCOUNT_ID=
# The Page the ads run under; MESSENGER_PAGE_ID when unset.
# META_ADS_PAGE_ID=
# Graph API version for the Marketing API calls.
# META_ADS_GRAPH_VERSION=v26.0
# One Publish: the daily budget in the ad account's currency, for how many days (2 to 90), the countries
# (two-letter codes), the ages (18 to 65), and whether a new ad starts ACTIVE or PAUSED.
# ADS_DAILY_BUDGET=5
# ADS_DAYS=7
# ADS_COUNTRIES=US
# ADS_AGE_MIN=35
# ADS_AGE_MAX=64
# ADS_LAUNCH_STATUS=ACTIVE
# Read only by scripts/ads-check.mjs: the Prudence campaign's id, to check it (the console keeps its own).
# META_ADS_CAMPAIGN_ID=

# --- Optional ---
# Real emails to guardians (otherwise they land in /dev/outbox).
# RESEND_API_KEY=
# MAIL_FROM=Scam Shield <alerts@your-domain.example>
# Breach lookup on the senior's request (_product/specs/breach-exposure.md): with a key, Have I Been
# Pwned's search; without it, XposedOrNot's free list plus HIBP's free catalogue.
# HIBP_API_KEY=
# abuse.ch URLhaus lookups (host names only).
# ABUSECH_AUTH_KEY=
# Scam watch keyword search on Bluesky (_product/specs/public-database.md, line 8): the account's handle and an
# app password (Settings -> App passwords), never the account password. Declared, read by nothing yet.
# BLUESKY_IDENTIFIER=
# BLUESKY_APP_PASSWORD=
# The public database (/public/, _product/specs/public-database.md): the operator line and the contact point on its
# About page and contest form. Not secrets; defaults name the team and the repository's issues page.
# PUBLIC_DB_OPERATOR=
# PUBLIC_DB_CONTACT=

# --- Llama Prompt Guard 2, the injection shield (_product/specs/prompt-guard.md). Optional: without a key
# it is off and verdicts are unchanged. With both keys, Groq is used.
# GROQ_API_KEY=
# A Hugging Face token with the "Inference Providers" permission, whose account has accepted the licence
# at huggingface.co/meta-llama/Llama-Prompt-Guard-2-86M (gated, Llama 4 Community License).
# HF_TOKEN=
# auto (the default: groq, else hf, else off) | groq | hf | mock | off
# PROMPT_GUARD_PROVIDER=auto
# A chunk scoring at or above this counts as an attack.
# PROMPT_GUARD_THRESHOLD=0.8
# The whole scan's budget in milliseconds; a verdict never waits longer.
# PROMPT_GUARD_TIMEOUT_MS=3000
# LLM_TRANSCRIBE_MODEL=whisper-1   # OpenAI-style transcription model; Meta's Muse Voice Transcribe is used whenever META_MODEL_API_KEY is set

# --- Observability (_product/specs/observability.md). Optional: without them nothing is sent or pinged and the
# app runs as before.
# Rollbar, a post_server_item token: errors of 500 and above, uncaught exceptions, background jobs when they start
# failing and when they recover; method and route only, emails and phone numbers masked. Items carry NODE_ENV
# (laptops report as development) and APP_VERSION.
# ROLLBAR_ACCESS_TOKEN=
# Better Stack heartbeats, one per job, pinged in production only (NODE_ENV=production): the URL after a run that
# succeeded, <url>/fail after one that failed. Each URL is a secret.
# HEARTBEAT_POLL_URL=
# HEARTBEAT_WATCH_URL=
# HEARTBEAT_THREATFEED_URL=
# HEARTBEAT_SCAMWATCH_URL=
# HEARTBEAT_RETENTION_URL=
# The daily database dump on the OVH host (_product/docs/ops.md, Backups): make deploy copies it into the host's .env,
# where backup.sh pings it after each dump (<url>/fail when the dump failed).
# HEARTBEAT_BACKUP_URL=
# The version /api/health and Rollbar name; the image sets it to the git sha (make prod-build). "dev" when unset.
# APP_VERSION=
# Which proxies may name the client's address (Fastify trustProxy), so behind the tunnel the visitor, not the
# tunnel, keys the rate limits: false (the default: the socket's address); true (the proxies on this machine or its
# private networks, such as cloudflared: the address Cloudflare appended, never one a visitor wrote); or the proxies'
# addresses, CIDRs or names (loopback, uniquelocal), comma-separated.
# TRUST_PROXY=false
